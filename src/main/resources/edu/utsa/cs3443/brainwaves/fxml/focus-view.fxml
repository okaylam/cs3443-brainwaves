<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.brainwaves.controller.FocusController"
      spacing="20" alignment="CENTER" style="-fx-padding: 30;">
    <children>
        <Label fx:id="timerLabel" text="25:00" style="-fx-font-size: 36px; -fx-font-weight: bold;"/>
        <HBox spacing="15" alignment="CENTER">
            <children>
                <Button text="Start" onAction="#handleStart"/>
                <Button text="Pause" onAction="#handlePause"/>
                <Button text="Reset" onAction="#handleReset"/>
            </children>
        </HBox>
    </children>
</VBox>
