<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="contentHolder" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.brainwaves.controller.TaskViewController">

   <children>
       
      <BorderPane prefHeight="844.0" prefWidth="390.0" styleClass="app" stylesheets="@../css/app.css">
         <top>
            <HBox fx:id="header" alignment="CENTER" prefHeight="41.0" prefWidth="395.0" styleClass="header" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="brand" text="brainwaves" textAlignment="CENTER" textFill="#ff7d59">
                     <font>
                        <Font name="Avigea" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </top>
         <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="747.0" prefWidth="390.0" styleClass="transparent" vbarPolicy="NEVER" BorderPane.alignment="CENTER">
               <content>
                  <VBox id="tasksLayout" prefHeight="200.0" prefWidth="389.0" spacing="18.0" styleClass="transparent">
                     <children>
                        <HBox fx:id="tasksHeader" alignment="CENTER" prefHeight="52.0" prefWidth="388.0" styleClass="transparent">
                           <children>
                              <Pane prefHeight="71.0" prefWidth="12.0" />
                              <VBox prefHeight="71.0" prefWidth="143.0">
                                 <children>
                                    <Label text="Tasks">
                                       <font>
                                          <Font name="Avigea" size="20.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="progressLabel" prefHeight="17.0" prefWidth="167.0" text="0 pending • 0 complete">
                                       <font>
                                          <Font name="SansSerif Regular" size="12.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                              <Pane prefHeight="40.0" prefWidth="95.0" />
                              <Button fx:id="addTaskButton" mnemonicParsing="false" onAction="#handleAddTask" prefHeight="25.0" prefWidth="111.0" styleClass="add-btn" text="+ Add Task">
                                 <font>
                                    <Font name="SansSerif Bold" size="12.0" />
                                 </font>
                              </Button>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
                           </padding>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </HBox>
                        <VBox fx:id="taskContainer" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="12.0">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </center>
         <bottom>
            <StackPane prefHeight="57.0" prefWidth="390.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER" prefHeight="55.0" prefWidth="329.0" styleClass="nav-bar">
                     <children>
                          <ToggleButton fx:id="homeButton" contentDisplay="TOP" prefHeight="35.0" prefWidth="64.0" styleClass="nav-btn" text="Home" textFill="#c0d9fa">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/home.png" />
                                 </image>
                                 <viewport>
                                    <Rectangle2D />
                                 </viewport>
                              </ImageView>
                           </graphic>
                           <font>
                              <Font size="10.0" />
                           </font>
                          </ToggleButton>
                          <ToggleButton contentDisplay="TOP" prefWidth="64.0" selected="true" styleClass="nav-btn" text="Tasks">
                           <font>
                              <Font size="10.0" />
                           </font>
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/checkbox.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                          </ToggleButton>
                          <ToggleButton contentDisplay="TOP" prefWidth="64.0" styleClass="nav-btn" text="Notes">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/notes.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <font>
                              <Font size="10.0" />
                           </font>
                          </ToggleButton>
                        <ToggleButton contentDisplay="TOP" mnemonicParsing="false" prefWidth="64.0" styleClass="nav-btn" text="Focus">
                           <font>
                              <Font size="10.0" />
                           </font>
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/timer.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </ToggleButton>
                     </children>
                     <padding>
                        <Insets left="200.0" />
                     </padding>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </StackPane>
         </bottom>
         <StackPane.margin>
            <Insets bottom="10.0" />
         </StackPane.margin>
      </BorderPane>
      <StackPane fx:id="addTaskOverlay" managed="false" prefHeight="150.0" prefWidth="200.0" styleClass="overlay" stylesheets="@../css/app.css" visible="false" StackPane.alignment="CENTER">
         <children>
            <VBox fx:id="addTaskCard" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="450.0" prefWidth="320.0" styleClass="add-task-card" stylesheets="@../css/app.css" StackPane.alignment="CENTER">
               <children>
                  <Label prefHeight="54.0" prefWidth="198.0" styleClass="add-task-title" text="✨ Add New Task">
                     <font>
                        <Font name="Avigea" size="24.0" />
                     </font>
                  </Label>
                  <VBox prefHeight="51.0" prefWidth="280.0">
                     <children>
                        <Label text="Task Title *">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="titleField" prefWidth="280.0" promptText="What's on your brain?" styleClass="input-field" />
                     </children>
                  </VBox>
                  <VBox prefHeight="95.0" prefWidth="280.0">
                     <children>
                        <Label text="Description">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextArea fx:id="descField" prefHeight="70.0" prefWidth="280.0" promptText="Add some details..." styleClass="description-field" wrapText="true" />
                     </children>
                  </VBox>
                  <HBox prefHeight="53.0" prefWidth="280.0" spacing="80.0">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Subject">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="subjectField" promptText="e.g. Math" styleClass="input-field" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <ChoiceBox fx:id="priorityBox" prefWidth="150.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="49.0" prefWidth="280.0" spacing="80.0">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Due Date *">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <DatePicker fx:id="dueDatePicker" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Time Estimate">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Spinner fx:id="timeSpinner" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="BOTTOM_RIGHT" prefHeight="71.0" prefWidth="280.0" spacing="15.0">
                     <children>
                        <Button fx:id="cancelTaskButton" mnemonicParsing="false" onAction="#handleCancelAddTask" styleClass="cancel-btn" text="Cancel" />
                        <Button fx:id="confirmAddTaskButton" mnemonicParsing="false" onAction="#handleConfirmAddTask" styleClass="add-btn" text="+ Add Task" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
