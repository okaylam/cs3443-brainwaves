<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.brainwaves.controller.ProfileController"
      spacing="15" alignment="TOP_CENTER"
      style="-fx-padding: 20;">
    <children>

        <!-- Title -->
        <Label text="Profile"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- Username (clickable) -->
        <Label fx:id="usernameLabel"
               text="Username"
               style="-fx-font-size: 16px;">
            <tooltip>
                <Tooltip text="Click to personalize your name" />
            </tooltip>
        </Label>

        <!-- XP progress bar -->
        <ProgressBar fx:id="xpBar" prefWidth="250" />

        <!-- XP label (clickable) -->
        <Label fx:id="xpLabel"
               text="XP: 0"
               style="-fx-text-fill: #55CBCD;">
            <tooltip>
                <Tooltip text="Click to enter your motivation quote" />
            </tooltip>
        </Label>

        <!-- Motivation quote display -->
        <Label fx:id="quoteLabel"
               text="“What motivates you today?”"
               style="-fx-font-style: italic; -fx-text-fill: #555; -fx-wrap-text: true; -fx-max-width: 250;" />

        <!-- Badge container -->
        <FlowPane fx:id="badgeContainer"
                  hgap="15" vgap="15"
                  prefWrapLength="300" />

    </children>
</VBox>

