<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.brainwaves.controller.NotesController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">
    <children>
        <!-- Notes area -->
        <TextArea fx:id="notesArea" prefHeight="400" prefWidth="350"
                  promptText="Write your notes here..." wrapText="true"/>

        <!-- Save button -->
        <Button text="Save Notes" onAction="#saveNotes"/>
    </children>
</VBox>

