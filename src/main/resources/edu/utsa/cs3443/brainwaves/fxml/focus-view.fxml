<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.brainwaves.controller.FocusController"
      spacing="15" alignment="CENTER" style="-fx-padding: 20;">
    <children>
        <!-- Timer label -->
        <Label fx:id="timerLabel" text="25:00" style="-fx-font-size: 36px;"/>

        <!-- Progress bar -->
        <ProgressBar fx:id="focusProgress" prefWidth="250"/>

        <!-- Preset duration buttons -->
        <HBox spacing="10" alignment="CENTER">
            <children>
                <Button text="5 min" onAction="#setDuration5"/>
                <Button text="15 min" onAction="#setDuration15"/>
                <Button text="25 min" onAction="#setDuration25"/>
                <Button text="30 min" onAction="#setDuration30"/>
            </children>
        </HBox>

        <!-- Control buttons -->
        <HBox spacing="10" alignment="CENTER">
            <children>
                <Button text="Start" onAction="#startTimer"/>
                <Button text="Pause" onAction="#pauseTimer"/>
                <Button text="Reset" onAction="#resetTimer"/>
            </children>
        </HBox>
    </children>
</VBox>

