<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.brainwaves.controller.ProfileController"
      spacing="15" alignment="TOP_CENTER" style="-fx-padding: 20;">
    <children>
        <Label text="Profile" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label fx:id="xpLabel" text="XP: 0" style="-fx-text-fill: #55CBCD;"/>
        <FlowPane fx:id="badgeContainer" hgap="15" vgap="15" prefWrapLength="300"/>
    </children>
</VBox>
