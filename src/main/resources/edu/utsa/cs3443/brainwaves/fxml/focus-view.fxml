<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.brainwaves.controller.FocusController"
      spacing="15" alignment="CENTER"
      styleClass="card"
      stylesheets="@../css/app.css">

    <!-- Timer label (clickable) -->
    <Label fx:id="timerLabel"
           text="25:00"
           onMouseClicked="#handleCustomTime"
           styleClass="timer-label">
        <tooltip>
            <Tooltip text="Click to set a custom time"/>
        </tooltip>
    </Label>

    <!-- Progress bar -->
    <ProgressBar fx:id="focusProgress" prefWidth="250" />

    <!-- Focus quote label -->
    <Label fx:id="focusQuoteLabel"
           text="“Stay focused and never give up.”"
           wrapText="true"
           style="-fx-font-style: italic; -fx-text-fill: #555; -fx-font-size: 14px; -fx-max-width: 280;" />

    <!-- Preset duration buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="5 min" onAction="#setDuration5" styleClass="button">
            <tooltip><Tooltip text="Set timer to 5 minutes"/></tooltip>
        </Button>
        <Button text="15 min" onAction="#setDuration15" styleClass="button">
            <tooltip><Tooltip text="Set timer to 15 minutes"/></tooltip>
        </Button>
        <Button text="25 min" onAction="#setDuration25" styleClass="button">
            <tooltip><Tooltip text="Set timer to 25 minutes"/></tooltip>
        </Button>
        <Button text="30 min" onAction="#setDuration30" styleClass="button">
            <tooltip><Tooltip text="Set timer to 30 minutes"/></tooltip>
        </Button>
    </HBox>

    <!-- Control buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Start" onAction="#startTimer" styleClass="button">
            <tooltip><Tooltip text="Start focus session"/></tooltip>
        </Button>
        <Button text="Pause" onAction="#pauseTimer" styleClass="button">
            <tooltip><Tooltip text="Pause timer"/></tooltip>
        </Button>
        <Button text="Resume" onAction="#resumeTimer" styleClass="button">
            <tooltip><Tooltip text="Resume paused timer"/></tooltip>
        </Button>
        <Button text="Reset" onAction="#resetTimer" styleClass="button">
            <tooltip><Tooltip text="Reset timer"/></tooltip>
        </Button>
    </HBox>
</VBox>


